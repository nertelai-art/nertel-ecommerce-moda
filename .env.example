# Només el servidor consulta el catàleg. No utilitzar service_role ni claus secretes.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Per preparar .env.local amb la clau anon de Docker: npm run db:env

APP_ORIGIN=http://localhost:3000
# La política MFA administrativa viu a private.security_settings i és true per defecte.
# El seed local la desactiva; no es controla des del navegador ni amb una variable pública.

# Només si el desplegament té al davant un proxy que normalitza x-forwarded-for.
# A Vercel deixa-ho buit: la plataforma ja posa x-vercel-forwarded-for, que el
# navegador no pot falsejar. Posar-ho a 1 sense proxy de confiança fa que
# qualsevol client pugui burlar el límit de ritme amb una capçalera inventada.
TRUST_FORWARDED_FOR=
