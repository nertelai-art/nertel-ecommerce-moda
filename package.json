{
  "name": "moda-pwa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "node scripts/require-pnpm.mjs && next dev --port 3300",
    "db:auth": "node scripts/db-auth-local.mjs",
    "test:e2e": "playwright test",
    "db:env": "node scripts/db-local.mjs env",
    "db:start": "node scripts/db-local.mjs start",
    "db:stop": "node scripts/db-local.mjs stop",
    "db:verify-network": "node scripts/db-local.mjs verify-network",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:test": "supabase test db --local --network-id nertel-ecommerce-moda-local",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on error",
    "env:preproduction": "node scripts/validate-deployment-env.mjs preproduction",
    "env:production": "node scripts/validate-deployment-env.mjs production",
    "release:check": "pnpm check && pnpm build && pnpm db:test && pnpm db:advisors",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.114.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
