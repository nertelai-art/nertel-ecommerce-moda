# Copieu aquests noms a les variables Preview de Vercel. No cometeu els valors.
DEPLOYMENT_ENV=preproduction
APP_ORIGIN=https://preview.example.com
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe continua deliberadament desactivat. No afegiu claus fins a implementar
# i validar el webhook, la reconciliació i la política de devolucions.
PAYMENTS_MODE=disabled

# Vercel ja posa x-vercel-forwarded-for. Només cal en desplegaments amb un
# proxy propi al davant que normalitzi x-forwarded-for.
TRUST_FORWARDED_FOR=
# VERCEL=1 el posa la plataforma. Fora de Vercel cal el proxy anterior.
